# Prod: CloudFront terminates HTTPS and forwards /api/* here over HTTP.
# Port 80 is only open to CloudFront's origin-facing IP ranges (see infra/bootstrap.yml).
# To add a custom domain later, replace :80 with the domain and Caddy will fetch a cert.
:80 {
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	respond 404
}
