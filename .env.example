# Copy to .env for local dev (`make setup` does this). Never commit .env.
ENV=local
DATABASE_URL=postgresql://cpsc:cpsc@localhost:5432/cpsc
AWS_REGION=us-east-1
# S3 bucket for raw source files and backups (CloudFormation output DataBucketName). Empty = local only.
DATA_BUCKET=
# AWS_PROFILE=default

# fake = canned responses, no AWS calls, free (default for tests/CI)
# bedrock = real Titan + Haiku calls using your AWS profile
LLM_MODE=fake

LIMIT_PER_VISITOR_DAY=20
LIMIT_PER_IP_DAY=40
LIMIT_BURST_PER_MINUTE=5
LIMIT_GLOBAL_DAY=500
